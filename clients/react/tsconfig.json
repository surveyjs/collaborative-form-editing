{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            // The file:-linked survey-react-ui carries its own @types/react copy;
            // pin every react type reference to this app's single copy.
            "react": ["./node_modules/@types/react"],
            "react-dom": ["./node_modules/@types/react-dom"]
        }
    },
    "include": ["src", "vite.config.ts", "../../shared"]
}
